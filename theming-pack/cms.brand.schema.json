{
  "$ref": "#/definitions/cms.brand",
  "definitions": {
    "cms.brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "alt": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "width",
                "height",
                "alt",
                "mimeType"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "favicon": {
          "anyOf": [
            {
              "$ref": "#/definitions/cms.brand/properties/logo/anyOf/0"
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "socials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "name",
        "logo",
        "favicon",
        "primaryColor",
        "socials"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}