#!/usr/bin/env bash
# Не даёт закоммитить в основную ветку напрямую.
#
# ПОЧЕМУ ХУК, А НЕ ПРАВИЛО. Правило «в master не коммитим» у нас есть давно и
# держится на том, что человек посмотрит, на какой он ветке. 24.10 я не
# посмотрел: после слияния рабочий каталог остался на `master`, и коммит лёг
# туда. Наружу не ушло только потому, что я заметил тишину — ветка на сервере
# не двигалась.
#
# Это тот же разбор, что у владельца про валюту: неизменяемое должно быть
# неизменяемым **в механизме**, а не в дисциплине. Запрет на правку журнала
# стоит триггером в базе, а не памяткой; здесь по той же причине хук.
#
# ПОЧЕМУ УСТАНОВКА ВШИТА В ПРОГОН. Хук, который каждый ставит руками, — та же
# дисциплина, только с лишним шагом: поставит тот, кто и так помнит. Поэтому
# `scripts/test.sh` прописывает `core.hooksPath` при каждом запуске (одна
# строка, идемпотентно), а прогон запускают все.
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

case "$branch" in
  master|main)
    echo "[pre-commit] ОТКАЗ: коммит прямо в «$branch»." >&2
    echo "[pre-commit] Работа идёт ветками; в основную попадает слиянием." >&2
    echo "[pre-commit] Если ветка уже нужна, перенести сделанное:" >&2
    echo "[pre-commit]     git switch -c <ветка>" >&2
    echo "[pre-commit] Осознанное исключение — git commit --no-verify." >&2
    exit 1
    ;;
esac

exit 0
