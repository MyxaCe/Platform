{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "public/api.js",
    "public/diag.js",
    "public/stats.js",
    "public/trades.js"
  ],
  "exclude": ["node_modules"]
}
