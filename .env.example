# Пример локальных настроек. Скопировать в .env и поправить под себя.
# Файл .env в git не попадает (см. .gitignore). Все значения ниже — дефолты
# docker-compose.yml: без .env терминал поднимется ровно с ними.

# --- База данных ---
# Задана → gateway пишет счета в PostgreSQL (ADR-016). Убрать сервис postgres
# или переменную DATABASE_URL у gateway → NoopStore, состояние только в памяти.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform          # на сервере обязательно сменить
POSTGRES_DB=platform

# --- Режим работы (ADR-023, Т2) ---
# 1 — автономный режим (дефолт репозитория): торговля на счёте по умолчанию без токена.
# 0 — SSO включён: торговые ручки требуют bearer-сессию, выданную по handoff-JWT
#     кабинета, и БД становится обязательной (identity-маппинг (tenant, sub)).
#     Без запущенного кабинета терминал покажет прочерки и «NO CABINET SESSION».
SSO_DISABLED=1
# Откуда gateway берёт JWKS платформы: {CABINET_URL}/api/sso/jwks.
# Из контейнера кабинет на хосте доступен как host.docker.internal.
CABINET_URL=http://host.docker.internal:3002

# --- Демо-счёт ---
# Стартовый баланс в центах. 1000000 = $10k — выровнено под apex-ru, чтобы
# «Обзор» кабинета сходился. Целевое — per-tenant demoStartBalanceCents из CMS.
# ВНИМАНИЕ: дефолт в коде, если переменную не передать, — 10000000 ($100k).
DEMO_START_BALANCE_CENTS=1000000

# --- Allow-list инструментов per-site (ADR-023 Т3, регуляторика) ---
# Разные юрисдикции разрешают разное, поэтому сайту разрешён не весь список.
#
# Контракт — СИМВОЛЫ (решение штаба Р-024). Числовые id живут в DEFS терминала и
# больше нигде; сопоставление «символ → внутренний id» делает терминал у себя на
# границе. Символ, которого терминал не знает, — ОТКАЗ на весь список сайта, а не
# молчаливый пропуск: пропуск тихо сузил бы права, и никто бы не узнал.
#
# Основной источник — CMS, сервер-сервер:
#   GET {CMS_BASE_URL}/cms/sites/{slug} под заголовком X-API-Key, поле instruments.
# Нужны ОБЕ переменные, иначе источник CMS не используется (в лог уйдёт строка об этом).
# Ключ сюда не вписываем и в репозиторий не кладём: он берётся из окружения контура.
# CMS_BASE_URL=http://host.docker.internal:3101/v1
# CMS_API_KEY=<из окружения контура; в репозитории его быть не должно>
#
# Запасной источник для разработки и офлайна — статический список СИМВОЛАМИ.
# Формат: site:SYMBOL,SYMBOL;site2:SYMBOL
# TENANT_INSTRUMENTS=apex-ru:BTCUSD,ETHUSD,BNBUSD
#
# Ни одного источника → в тенантном режиме торговля ЗАКРЫТА (fail-closed, КОНТРАКТЫ
# §4б): отказ инфраструктуры не должен превращаться в разрешение. В standalone
# (без ?site=) ограничивать нечего — доступен весь список.

# --- White Label (ADR-023) ---
# Кто может встраивать терминал в iframe (CSP frame-ancestors). "*" = открыто (dev).
# Прод: список доменов сайтов платформы через пробел.
FRAME_ANCESTORS=*
# URL'ы ДЛЯ БРАУЗЕРА пользователя (не для контейнера): публичный brand-эндпоинт
# CMS и origin кабинета для postMessage/SSO. Дефолт — пусто (standalone).
# Задавать вместе с SSO_DISABLED=0: непустой CABINET_ORIGIN переводит фронт в
# embedded-режим, где без handoff-токена торговые ручки не дёргаются вовсе.
# BRAND_URL=http://localhost:3001/v1/cms/brand
# CABINET_ORIGIN=http://localhost:3002

# --- Шина событий платформы (TRM-40, КОНТРАКТЫ §5) ---
# Терминал публикует наружу факты счёта: terminal.account.opened,
# terminal.trade.executed, terminal.balance.changed — конверт v1, обменник
# platform.events, ключ маршрутизации = имя события.
#
# Не задан → РЕЛЕЙ НЕ ЗАПУСКАЕТСЯ, но исходящая очередь наполняется всё равно.
# События копятся в таблице bus_outbox и уедут после настройки; их число видно
# в /health (outbox_pending). Молча терять их, пока адреса нет, нельзя — именно
# так выглядел прежний «массив в памяти» (Р-204).
#
# Кредл нужен СВОЙ, не site-web и не cabinet: терминалу достаточно write на
# обменник, configure не нужен вовсе (обменник объявляется ПАССИВНО, §4а).
#   rabbitmqctl set_permissions -p platform terminal "" "^platform\.events$" ""
# BUS_URL=amqp://terminal:<пароль>@bus:5672/platform
# BUS_EXCHANGE=platform.events
#
# ВАЖНО: событие адресуется парой (tenant, sub) из таблицы identities, то есть
# ТОЛЬКО для счетов, заведённых входом по SSO. При SSO_DISABLED=1 все работают
# на общем счёте DEFAULT_USER, у него внешней личности нет, и на шину не уйдёт
# ничего. /health говорит об этом полем shared_account.

# --- Риск-контроль: принудительное закрытие по марже (TRM-49) ---
# Уровень маржи (equity / занятая маржа, в процентах), ниже которого позиции
# закрываются принудительно. Закрывается самая убыточная, по одной, пока уровень
# не поднимется выше порога.
#
# УМОЛЧАНИЯ НЕТ НАМЕРЕННО. Порог — свойство юрисдикции, и его место в профиле
# (CMS-24, по умолчанию Сейшелы). Выдуманный на нашей стороне, он молча
# разошёлся бы с тем, по которому считает источник, — то же правило, по которому
# порог свежести котировок задаёт MDS, а не потребитель (КОНТРАКТЫ §5г).
#
# Не задан → ПРИНУДИТЕЛЬНОГО ЗАКРЫТИЯ НЕТ. Счёт ничем не ограничен снизу. Видно
# в логе старта и в /account полем stop_out_level_pct.
#
# Имя переменной выбрано как будущее имя поля профиля: появится профиль —
# поменяется источник, а не словарь.
#
# ЭТО ПОЛИТИКА БРОКЕРА, А НЕ ТРЕБОВАНИЕ РЕГУЛЯТОРА.
# Подтверждения требования в правилах Сейшел не нашли (проверяли штаб и владелец
# независимо), у брокеров под этой лицензией практика от 10 до 50 %.
# ГДЕ ЭТО ПРОВЕРЯТЬ: Securities Act (Сейшелы, 2007) и циркуляры/руководства
# FSA Seychelles для дилеров ценными бумагами — fsaseychelles.sc, раздел
# Securities. Мы искали там требование к уровню стоп-аута и НЕ НАШЛИ.
# «Не нашли» — это «не нашли», а не «не требует»: проверять юристу, и ссылки
# выше затем, чтобы он проверял, а не искал заново.
# Значит число выбрали мы и мы же вправе его менять — но осознанно, а не потому
# что «кто-то когда-то поставил 50».
#
# Довод за 50 %, и он не про соответствие стандартам: ОТРИЦАТЕЛЬНЫЙ БАЛАНС
# ОПЛАЧИВАЕМ МЫ. Чем ниже порог, тем чаще счёт успевает уйти в минус раньше
# закрытия, и тем чаще доплачиваем мы. Пятьдесят защищает обе стороны.
MARGIN_STOP_OUT_LEVEL_PERCENT=50
#
# Уровень ПРЕДУПРЕЖДЕНИЯ (маржин-колл, TRM-50). Обязан быть ВЫШЕ порога
# закрытия: предупреждение без запаса не оставляет времени отреагировать, а
# закрытие без предупреждения — срабатывание без шанса. Не задан →
# предупреждения нет, и об этом кричит лог старта.
#
# При достижении уровня клиент получает уведомление в кабинете, событие уходит
# на шину. Критерий владельца: ЕСЛИ УВЕДОМЛЕНИЕ НЕ ДОШЛО — ЭТО ДЕФЕКТ, а не
# «клиент не заметил».
MARGIN_CALL_LEVEL_PERCENT=100
