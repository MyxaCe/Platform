# Пример локальных настроек. Скопировать в .env и поправить под себя.
# Файл .env в git не попадает (см. .gitignore).

# --- База данных ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform          # на сервере обязательно сменить
POSTGRES_DB=platform

# --- Домен и cookie ---
# Локально: .lvh.me (публичное DNS-имя в 127.0.0.1).
# На сервере: .вашдомен — иначе сессия не будет общей для поддоменов.
COOKIE_DOMAIN=.lvh.me
# Раскомментировать, когда появится HTTPS: cookie станет Secure.
# COOKIE_SECURE=1

# --- Почта (ADR-019) ---
# Пока не задано, письма НЕ отправляются: код подтверждения печатается в лог шлюза.
# SMTP_URL=smtp://user:pass@mail.example.com:587
# MAIL_FROM=noreply@example.com
